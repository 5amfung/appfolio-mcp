# Copy to .env and set your Neon PostgreSQL connection string.
# Server-only: never prefix this variable with VITE_.
DATABASE_URL=
# The Neon integration supplies a direct connection for migrations.
DATABASE_URL_UNPOOLED=
# Non-secret production compute ID. Vercel migration guards reject any Preview
# connection to this production endpoint and any Production connection elsewhere.
NEON_PRODUCTION_ENDPOINT_ID=ep-calm-rain-bfxw1z2o

# Public PostHog project token (not a personal API key). Leave blank to disable.
VITE_POSTHOG_KEY=
# Use https://eu.i.posthog.com for EU projects, or your self-hosted ingestion URL.
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Canonical production/local origin. Leave unset in Vercel Preview so each PR
# uses its own trusted Vercel deployment URL and isolated OAuth issuer.
BETTER_AUTH_URL=http://localhost:3000
# Generate at least 32 random bytes for Better Auth. Server-only.
BETTER_AUTH_SECRET=
# AES-256-GCM keyring. Each key is 64 hex characters. Use single quotes in .env.
CREDENTIAL_KEYS='{"v1":""}'
CREDENTIAL_KEY_ID=v1

# Server-side PostHog Logs. Both may be absent locally; required for deployment acceptance.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com

# Shared tenant inventory and lazy unit cache lifetime in seconds. Default 12 hours.
# Cache hits avoid AppFolio reads; misses refill before validation can complete.
TENANT_VALIDATION_CACHE_TTL_SECONDS=43200

# Live verification ONLY. Configure the designated AppFolio test database.
# These are not defaults for customers' saved connections.
APPFOLIO_TEST_CLIENT_ID=
APPFOLIO_TEST_CLIENT_SECRET=
APPFOLIO_TEST_DATABASE_ID=
APPFOLIO_TEST_DEVELOPER_ID=
