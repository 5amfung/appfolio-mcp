# Copy to .env and set your Neon PostgreSQL connection string.
# Server-only: never prefix this variable with VITE_.
DATABASE_URL=

# Public PostHog project token (not a personal API key). Leave blank to disable.
VITE_POSTHOG_KEY=
# Use https://eu.i.posthog.com for EU projects, or your self-hosted ingestion URL.
VITE_POSTHOG_HOST=https://us.i.posthog.com
